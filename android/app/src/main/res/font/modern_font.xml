<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 8/9 use the approved Noto family for both Chinese and Latin.
         Android 10+ adds Inter ahead of it in NativeTypography. -->
    <font android:font="@font/noto_sans_sc" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/noto_sans_sc" android:fontStyle="normal" android:fontWeight="500" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/noto_sans_sc" android:fontStyle="normal" android:fontWeight="600" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/noto_sans_sc" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
</font-family>
